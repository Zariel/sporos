#!/usr/bin/env bash
set -euo pipefail

if command -v podman >/dev/null 2>&1; then
  engine=podman
elif command -v docker >/dev/null 2>&1; then
  engine=docker
else
  echo "Podman or Docker is required" >&2
  exit 1
fi

tag="localhost/sporos-smoke:phase1"
name="sporos-image-smoke-$$"
volume="sporos-image-smoke-$$"

# The EXIT trap owns cleanup on both success and failure.
# shellcheck disable=SC2329
cleanup() {
  "$engine" rm --force "$name" >/dev/null 2>&1 || true
  "$engine" volume rm "$volume" >/dev/null 2>&1 || true
}
trap cleanup EXIT

"$engine" build --tag "$tag" .
"$engine" volume create "$volume" >/dev/null
"$engine" run --detach \
  --name "$name" \
  --read-only \
  --tmpfs /tmp:rw,nosuid,nodev,size=16m \
  --volume "$volume:/data" \
  --publish 127.0.0.1::8080 \
  --env 'SPOROS__AUTH__WEBHOOK_TOKEN="webhook-smoke"' \
  --env 'SPOROS__AUTH__ADMIN_TOKEN="admin-smoke"' \
  --env 'SPOROS__SERVER__SHUTDOWN_GRACE="1s"' \
  "$tag" >/dev/null

port="$($engine port "$name" 8080/tcp | awk -F: 'NR == 1 { print $NF }')"
for _ in $(seq 1 100); do
  if curl --fail --silent "http://127.0.0.1:${port}/readyz" >/dev/null; then
    break
  fi
  sleep 0.1
done
curl --fail --silent "http://127.0.0.1:${port}/livez" >/dev/null
curl --fail --silent "http://127.0.0.1:${port}/readyz" >/dev/null

user="$($engine image inspect "$tag" --format '{{.Config.User}}')"
test "$user" = "65532:65532"
logs="$($engine logs "$name")"
grep -q '"message":"service ready"' <<<"$logs"
grep -q '"service":"sporos"' <<<"$logs"

"$engine" kill --signal TERM "$name" >/dev/null
for _ in $(seq 1 100); do
  if ! "$engine" container inspect "$name" --format '{{.State.Running}}' | grep -q true; then
    exit 0
  fi
  sleep 0.1
done

echo "container did not stop within the smoke-test deadline" >&2
exit 1
