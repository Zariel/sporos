#!/usr/bin/env bash
set -euo pipefail

production=(
    crates/sporos-model/src
    crates/sporos-matcher/src
    crates/sporos-service/src
)

if rg -n 'remove_file|remove_dir(_all)?|unlink\(|torrents/delete|delete_torrent' "${production[@]}"; then
    echo 'production code contains a deletion capability' >&2
    exit 1
fi

while IFS= read -r source; do
    [[ $source == */duroxide_phase0.rs ]] && continue
    if awk '/#\[cfg\(test\)\]/{exit} {print}' "$source" \
        | rg -n 'Command::new|std::process::Command|tokio::process'; then
        echo "production code contains external command execution: $source" >&2
        exit 1
    fi
done < <(rg --files "${production[@]}" -g '*.rs')

if rg -n 'sporos-(service|testkit)|sqlx|reqwest|axum|duroxide' crates/sporos-matcher/Cargo.toml; then
    echo 'pure matcher boundary contains an I/O or service dependency' >&2
    exit 1
fi

if rg --files -g 'Chart.yaml' -g 'kustomization.yaml' -g '*.helm.yaml' -g '*deployment*.yaml' | rg .; then
    echo 'repository contains a Kubernetes deployment artifact' >&2
    exit 1
fi

while IFS= read -r source; do
    [[ $source == */outbox.rs || $source == */duroxide_phase0.rs ]] && continue
    if awk '/#\[cfg\(test\)\]/{exit} {print}' "$source" | rg -n 'lease_token|lease_until'; then
        echo "start-command lease fields are used outside outbox.rs: $source" >&2
        exit 1
    fi
done < <(rg --files crates/sporos-service/src -g '*.rs')

api_routes=(
    '/api/v1/autobrr/check' \
    '/api/v1/autobrr/torrents' \
    '/api/v1/admin/tasks' \
    '/api/v1/admin/operations' \
    '/api/v1/admin/operations/{operation_id}' \
    '/api/v1/admin/searches' \
    '/api/v1/admin/data-scans' \
    '/api/v1/admin/tasks/{task_id}' \
    '/api/v1/admin/tasks/{task_id}/retry' \
    '/api/v1/admin/tasks/{task_id}/cancel' \
    '/api/v1/admin/tasks/{task_id}/events' \
    '/api/v1/admin/inventory' \
    '/api/v1/admin/inventory/torrents' \
    '/api/v1/admin/inventory/reconcile'
)

for route in "${api_routes[@]}"; do
    rg -F --quiet "$route" crates/sporos-service/src/http.rs
    rg -F --quiet "  $route:" docs/openapi.yaml
done

if rg -n '/api/v1/.*(delete|cleanup|remove)' crates/sporos-service/src/http.rs; then
    echo 'administrative HTTP surface contains a cleanup route' >&2
    exit 1
fi
if rg -n '^  /api/v1/.*(delete|cleanup|remove)' docs/openapi.yaml; then
    echo 'administrative OpenAPI surface contains a cleanup route' >&2
    exit 1
fi
